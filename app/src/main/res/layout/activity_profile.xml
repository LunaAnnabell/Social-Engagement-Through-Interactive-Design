<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FFFFFF">

    <!-- Scrollable User Info Section -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <!-- Your Profile Rectangle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:layout_marginTop="70dp"
                android:orientation="horizontal"
                android:backgroundTint="#CCCCCC"
                android:backgroundTintMode="src_over"
                android:elevation="2dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/rounded_background"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Profile"
                    android:textSize="30dp"
                    android:textStyle="bold"
                    android:textColor="#000000" />
            </LinearLayout>
            <!-- User Info Card -->
            <LinearLayout
                android:id="@+id/userInfoCard"
                android:layout_width="match_parent"
                android:layout_height="242dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/rounded_background"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="25dp">

                <!-- Username Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/usernameLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Username: "
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/usernameValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UserName"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- Password Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/passwordLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Password: "
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/passwordValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="************"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/viewPasswordBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="View"
                        android:textSize="14sp" />

                </LinearLayout>
            </LinearLayout>

            <!-- Sign Out Button -->
            <Button
                android:id="@+id/signOutButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Sign Out" />
        </LinearLayout>
    </ScrollView>

    <!-- Character Selection Section -->
    <TextView
        android:id="@+id/chooseCharacterText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Choose a different character:"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/characterSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:weightSum="5">

        <!-- Each character -->

        <!-- Tipsy -->
        <LinearLayout
            android:id="@+id/categoryContainerTipsy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">
            <ImageView
                android:id="@+id/categoryTipsy"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/tipsy" />
            <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
                android:foregroundGravity="center">
            <!-- Colored rectangle background -->
            <View
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:background="#FF308DF6" /> <!-- your color -->

            <!-- Text on top -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:text="Tipsy"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp" />
        </FrameLayout>
        </LinearLayout>
<!-- Bongo -->
        <LinearLayout
            android:id="@+id/categoryContainerBongo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">
            <ImageView
                android:id="@+id/categoryBongo"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/bongo" />
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:foregroundGravity="center">

                <!-- Colored rectangle background -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:background="#FFFF964A" /> <!-- your color -->

                <!-- Text on top -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:text="Bongo"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp" />
            </FrameLayout>
        </LinearLayout>
<!-- Rally -->
        <LinearLayout
            android:id="@+id/categoryContainerRally"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">
            <ImageView
                android:id="@+id/categoryRally"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/rally" />
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:foregroundGravity="center">

                <!-- Colored rectangle background -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:background="#FFFC4780" /> <!-- your color -->

                <!-- Text on top -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:text="Rally"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp" />
            </FrameLayout>
        </LinearLayout>
<!-- Sketchy -->
        <LinearLayout
            android:id="@+id/categoryContainerSketchy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">
            <ImageView
                android:id="@+id/categorySketchy"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/sketchy" />
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:foregroundGravity="center">

                <!-- Colored rectangle background -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:background="#FF2ECC71" /> <!-- your color -->

                <!-- Text on top -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:text="Sketchy"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp" />
            </FrameLayout>
        </LinearLayout>
<!-- Glitch-->
        <LinearLayout
            android:id="@+id/categoryContainerGlitch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">
            <ImageView
                android:id="@+id/categoryGlitch"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/glitch" />
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <!-- Colored rectangle background -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:background="#FFFFDD57" /> <!-- your color -->

                <!-- Text on top -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:text="Glitch"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Navigation Bar -->
    <include
        android:id="@+id/navigationBar"
        layout="@layout/activity_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
